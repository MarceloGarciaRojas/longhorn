# Ambiente lógico de la aplicación.
# Valores permitidos: local, test, development, alpha, staging, production.
APP_ENV=local

# URL pública canónica. Obligatoria y HTTPS en alpha, staging y production.
APP_URL=http://localhost:3000

# Versión visible en el endpoint de salud. No es secreta.
APP_VERSION=0.1.0

# SHA del commit desplegado, cuando el pipeline lo proporcione. No es secreto.
APP_COMMIT_SHA=local

# Nivel mínimo de logging: debug, info, warn o error.
LOG_LEVEL=info

# Conexiones PostgreSQL. Todas son secretas fuera de local/CI y nunca deben
# utilizar prefijos públicos. Estos valores pertenecen solo al contenedor local.
DATABASE_ADMIN_URL=postgresql://postgres:nexi_postgres_local@127.0.0.1:54329/nexi_test
DATABASE_MIGRATION_URL=postgresql://nexi_migrator:nexi_migration_local@127.0.0.1:54329/nexi_test
DATABASE_URL=postgresql://nexi_app:nexi_app_local@127.0.0.1:54329/nexi_test
TEST_DATABASE_URL=postgresql://nexi_app:nexi_app_local@127.0.0.1:54329/nexi_test

# Proveedor de identidad. `test` solo funciona en APP_ENV=local o test.
# En alpha, staging y production debe utilizarse `supabase`.
AUTH_PROVIDER=test

# Secreto de alta entropía utilizado para seudonimizar identificadores y
# cifrar concesiones de recuperación. Es obligatorio fuera de local/test.
AUTH_SECURITY_PEPPER=replace-with-a-random-secret-outside-local

# Duración máxima de las sesiones opacas administradas por Longhorn.
AUTH_SESSION_TTL_SECONDS=28800
AUTH_ADMIN_SESSION_TTL_SECONDS=7200
AUTH_INVITATION_TTL_SECONDS=86400

# Espera antes de archivar un sitio. Obligatoria en alpha/staging/production.
# Valores permitidos: 24 o 48.
SITE_DELETION_GRACE_HOURS=48

# Configuración server-side de Supabase Auth. No usar prefijos NEXT_PUBLIC.
# La publishable key identifica el proyecto, pero se conserva en el servidor
# para impedir que el frontend gestione tokens directamente.
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-supabase-publishable-key
# Solo server-side. Necesaria para enviar invitaciones fuera de local/test.
SUPABASE_SECRET_KEY=replace-with-supabase-secret-key

# Solo para pruebas locales/CI: JSON de identidades sintéticas. No se incluye
# un valor de ejemplo para evitar incorporar credenciales al repositorio.
# AUTH_TEST_IDENTITIES=
# AUTH_TEST_RECOVERY_TOKEN=

# Biblioteca multimedia. El proveedor local está permitido solamente en local
# y test. Si MEDIA_LOCAL_ROOT queda vacío se utiliza un directorio seguro bajo
# el temporal del sistema, fuera del repositorio y de OneDrive.
MEDIA_STORAGE_PROVIDER=local
# MEDIA_LOCAL_ROOT=
MEDIA_LOCAL_SERVICE_URL=http://127.0.0.1:43127
MEDIA_LOCAL_SERVICE_PORT=43127
MEDIA_UPLOAD_MAX_BYTES=10485760
MEDIA_MAX_WIDTH=8000
MEDIA_MAX_HEIGHT=8000
MEDIA_MAX_PIXELS=40000000
MEDIA_MAX_CONCURRENT_UPLOADS=2
MEDIA_PROCESSING_MODE=synchronous

# Puerta operacional Alfa. Estos valores ficticios se reemplazan únicamente
# en un archivo local `.env.alpha` ignorado por Git o en secretos del proveedor.
# CI no carga `.env.alpha` y `alpha:preflight` rechaza CI explícitamente.
ALPHA_RESOURCE_GUARD=nexi-alpha
# Solo bootstrap DB; deben ser secretos distintos de 32+ caracteres.
# ALPHA_APP_DB_PASSWORD=
# ALPHA_MIGRATOR_DB_PASSWORD=
ALPHA_DEPLOY_TARGET=cloudflare-workers
CLOUDFLARE_ACCOUNT_ID=00000000000000000000000000000000
CLOUDFLARE_HYPERDRIVE_ID=00000000000000000000000000000000
CLOUDFLARE_HYPERDRIVE_CACHING=disabled
# Ruta absoluta, fuera del repositorio, a evidencia real del smoke post-deploy.
# ALPHA_SMOKE_EVIDENCE_FILE=
MEDIA_SUPABASE_BUCKET=nexi-alpha-media

# Etapa 9A. El formulario queda habilitado por defecto solo en local/test.
# alpha, staging y production no pueden habilitarlo en esta etapa.
ONBOARDING_PUBLIC_FORM_ENABLED=true
ONBOARDING_PUBLIC_RATE_LIMIT=5
ONBOARDING_MAX_NOTES_LENGTH=1000
ONBOARDING_SUPPORTED_INDUSTRIES=restaurant
