{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": "24.14.0",
    "pnpm": "11.9.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:integration && pnpm test:rendered",
    "test:unit": "tsx --test tests/unit/config.test.ts tests/unit/database-config.test.ts tests/unit/logger.test.ts tests/unit/errors.test.ts tests/unit/auth-config.test.ts tests/unit/auth-security.test.ts tests/unit/alpha-config.test.ts tests/unit/alpha-db-bootstrap-config.test.ts tests/unit/alpha-smoke-evidence.test.ts tests/unit/public-host.test.ts tests/unit/industry-core.test.ts tests/unit/restaurant-schema.test.ts tests/unit/gym-v1.test.ts tests/unit/media-config.test.ts tests/unit/media-storage.test.ts tests/unit/supabase-storage.test.ts tests/unit/media-processing.test.ts tests/unit/restaurant-v2.test.ts && node --conditions=react-server --import tsx --test tests/unit/onboarding.test.ts tests/unit/runtime-connection.test.ts",
    "test:integration": "tsx --test tests/integration/health.test.ts",
    "test:auth": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx --test --test-concurrency=1 tests/unit/identity-provider-contract.test.ts tests/integration/auth-flow.test.ts",
    "test:admin": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx --test --test-concurrency=1 tests/unit/admin-security.test.ts tests/integration/admin-flow.test.ts",
    "test:client": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx --test --test-concurrency=1 tests/unit/client-security.test.ts tests/integration/client-portal-flow.test.ts",
    "test:operations": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx --test --test-concurrency=1 tests/integration/operations-flow.test.ts",
    "test:content": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx --test --test-concurrency=1 tests/unit/restaurant-schema.test.ts tests/unit/gym-v1.test.ts tests/integration/content-flow.test.ts tests/integration/gym-content-flow.test.ts",
    "test:media-seed": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx --test --test-concurrency=1 tests/integration/media-seed.test.ts",
    "test:media": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx --test --test-concurrency=1 tests/unit/media-config.test.ts tests/unit/media-storage.test.ts tests/unit/media-processing.test.ts tests/integration/media-flow.test.ts",
    "test:templates": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx --test --test-concurrency=1 tests/unit/restaurant-v2.test.ts tests/integration/template-flow.test.ts",
    "test:onboarding": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx --test --test-concurrency=1 tests/unit/onboarding.test.ts tests/integration/onboarding-flow.test.ts",
    "test:onboarding-e2e": "pnpm build && node --test --test-concurrency=1 tests/e2e/onboarding-http.test.mjs",
    "test:media-e2e": "pnpm build && node --test --test-concurrency=1 tests/e2e/media-http.test.mjs",
    "test:content-e2e": "pnpm build && node --test --test-concurrency=1 tests/e2e/content-http.test.mjs",
    "test:admin-e2e": "pnpm build && node --test --test-concurrency=1 tests/e2e/admin-http.test.mjs",
    "test:client-e2e": "pnpm build && node --test --test-concurrency=1 tests/e2e/client-http.test.mjs",
    "test:operations-e2e": "pnpm build && node --test --test-concurrency=1 tests/e2e/operations-http.test.mjs",
    "test:e2e": "pnpm build && node --test --test-concurrency=1 tests/e2e/auth-http.test.mjs",
    "test:auth-e2e": "pnpm test:e2e",
    "test:rendered": "pnpm build && node --test tests/rendered-html.test.mjs",
    "test:db": "node --env-file-if-exists=.env.local --import tsx --test --test-concurrency=1 tests/db/migrations.test.ts tests/db/tenant-isolation.test.ts",
    "test:tenant-isolation": "node --env-file-if-exists=.env.local --import tsx --test --test-concurrency=1 tests/db/tenant-isolation.test.ts",
    "test:tenant-access": "pnpm test:tenant-isolation",
    "auth:seed": "pnpm db:seed",
    "admin:seed-local": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/admin/cli.ts seed-local",
    "invitations:expire-local": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/admin/cli.ts expire-local",
    "db:up": "docker compose up -d --wait postgres && pnpm db:bootstrap",
    "db:down": "docker compose down",
    "db:clean": "docker compose down --volumes --remove-orphans",
    "db:bootstrap": "node --env-file-if-exists=.env.local --import tsx scripts/db/cli.ts bootstrap",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/db/cli.ts migrate",
    "db:status": "node --env-file-if-exists=.env.local --import tsx scripts/db/cli.ts status",
    "db:seed": "node --env-file-if-exists=.env.local --import tsx scripts/db/cli.ts seed",
    "db:reset": "node --env-file-if-exists=.env.local --import tsx scripts/db/cli.ts reset",
    "db:check": "node --env-file-if-exists=.env.local --import tsx scripts/db/cli.ts check",
    "alpha:preflight": "node --env-file=.env.alpha --import tsx scripts/alpha/preflight.ts",
    "alpha:db:provision": "node --env-file=.env.alpha --import tsx scripts/alpha/provision-db.ts",
    "alpha:db:migrate": "node --env-file=.env.alpha --import tsx scripts/db/cli.ts migrate",
    "alpha:db:status": "node --env-file=.env.alpha --import tsx scripts/db/cli.ts status",
    "alpha:db:check": "node --env-file=.env.alpha --import tsx scripts/db/cli.ts check",
    "alpha:backup": "node --env-file=.env.alpha --import tsx scripts/alpha/backup.ts",
    "alpha:backup:verify": "node --env-file=.env.alpha --import tsx scripts/alpha/verify-backup.ts",
    "alpha:build": "node --env-file=.env.alpha --import tsx scripts/alpha/build.ts",
    "alpha:smoke": "node --env-file=.env.alpha --import tsx scripts/alpha/smoke.ts",
    "test:prepare-base": "pnpm db:reset",
    "test:prepare-media": "pnpm db:reset && pnpm media:seed",
    "media:serve": "node --env-file-if-exists=.env.local --import tsx scripts/media/cli.ts serve",
    "media:process": "node --env-file-if-exists=.env.local --import tsx scripts/media/cli.ts process",
    "media:status": "node --env-file-if-exists=.env.local --import tsx scripts/media/cli.ts status",
    "media:clean-test": "node --env-file-if-exists=.env.local --import tsx scripts/media/cli.ts clean-test",
    "media:seed": "node --env-file-if-exists=.env.local --import tsx scripts/media/seed.ts",
    "onboarding:seed": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/onboarding/cli.ts seed",
    "onboarding:status": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/onboarding/cli.ts status",
    "onboarding:reset-test": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/onboarding/cli.ts reset-test",
    "security:secrets": "node scripts/check-secrets.mjs",
    "security:audit": "pnpm audit --audit-level high",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm security:secrets"
  },
  "dependencies": {
    "next": "16.2.11",
    "pg": "8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "sharp": "0.35.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.46.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "24.13.3",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.16",
    "wrangler": "4.113.0"
  },
  "type": "module"
}
